</div>

<!-- VIEW: PROCESSING -->
<div class="view" id="viewProc">
  <div class="proc-wrap">
    <div class="proc-ring"></div>
    <div class="proc-logos">
      <img src="assets/airtel-logo.svg" alt="Airtel" height="18" onerror="this.outerHTML='<span style=\'font-size:16px;font-weight:900;color:var(--red)\'>airtel</span>'">
      <span class="proc-x">&times;</span>
      <img src="assets/starlink-black.png" alt="Starlink" height="11" onerror="this.outerHTML='<span style=\'font-size:10px;font-weight:800;letter-spacing:1px;color:var(--on-surf)\'>STARLINK</span>'">
