<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no,viewport-fit=cover">
<meta name="theme-color" content="#C2001A">
<title>Airtel Congo × Starlink — Autoriser le Paiement</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600;9..40,700;9..40,800;9..40,900&family=DM+Mono:wght@500;600&display=swap" rel="stylesheet">
<style>
*,*::before,*::after{margin:0;padding:0;box-sizing:border-box;-webkit-tap-highlight-color:transparent}
html,body{height:100%}
body{font-family:'DM Sans',system-ui,sans-serif;-webkit-font-smoothing:antialiased;background:#F5F5F5;color:#1C1B1F;display:flex;flex-direction:column;position:fixed;inset:0;width:100%;height:100vh;height:100dvh;overflow:hidden}
button{font-family:inherit;touch-action:manipulation;border:none;background:none;cursor:pointer;outline:none;-webkit-user-select:none;user-select:none}
input{font-family:inherit;border:none;outline:none;background:none}
img{display:block;max-width:100%}
*{-webkit-user-select:none;user-select:none}
:root{
  --red:#C2001A;--red-dk:#960014;--red-lt:#FFDAD6;--on-red:#fff;--on-red-cont:#410002;
  --blue:#1B62B5;
  --surf:#FFFBFF;--surf-lo:#F7F2FA;--surf-mid:#F3EDF7;--surf-hi:#ECE6F0;
  --on-surf:#1C1B1F;--on-surf-v:#49454F;
  --outline:#79747E;--outline-v:#CAC4D0;
  --err:#B3261E;--ok:#386A20;--ok-cont:#C0EFA4;
  --r-sm:8px;--r-md:12px;--r-lg:16px;--r-xl:28px;--r-full:999px;
  --e1:0 1px 2px rgba(0,0,0,.12),0 1px 3px 1px rgba(0,0,0,.08);
  --e2:0 1px 2px rgba(0,0,0,.12),0 2px 6px 2px rgba(0,0,0,.10);
  --ease:cubic-bezier(.2,0,0,1);
}
@keyframes rip-anim{to{transform:scale(4);opacity:0}}
@keyframes pg-in{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:none}}
@keyframes spin{to{transform:rotate(360deg)}}

/* NAV */
.nav{flex-shrink:0;background:var(--red);display:flex;align-items:center;justify-content:space-between;padding:0 16px;height:calc(56px + env(safe-area-inset-top,0px));padding-top:env(safe-area-inset-top,0px);box-shadow:var(--e2);z-index:20}
.nav-back{display:flex;align-items:center;gap:8px;color:#fff;font-size:14px;font-weight:600;cursor:pointer;-webkit-user-select:none;user-select:none}
.nav-logos{display:flex;align-items:center;gap:8px}
.nav-sep{width:1px;height:16px;background:rgba(255,255,255,.3)}
.nav-spinner{width:20px;height:20px;border-radius:50%;border:2.5px solid rgba(255,255,255,.25);border-top-color:#fff;animation:spin 1s linear infinite;display:none;flex-shrink:0}

/* STEPS BAR */
.steps-bar{flex-shrink:0;background:var(--surf);border-bottom:1px solid var(--outline-v);padding:10px 20px;display:flex;align-items:center}
.si{display:flex;flex-direction:column;align-items:center;gap:3px;flex:1;position:relative}
.si+.si::before{content:'';position:absolute;top:9px;left:calc(-50%);width:100%;height:1.5px;background:var(--outline-v);z-index:0}
.si.done+.si::before{background:var(--red)}
.si-dot{width:18px;height:18px;border-radius:50%;border:2px solid var(--outline-v);background:var(--surf-mid);display:flex;align-items:center;justify-content:center;font-size:9px;font-weight:700;color:var(--on-surf-v);position:relative;z-index:1;transition:all .3s var(--ease)}
.si.done .si-dot{background:var(--red);border-color:var(--red);color:#fff}
.si.active .si-dot{background:var(--red);border-color:var(--red);color:#fff;box-shadow:0 0 0 3px rgba(194,0,26,.2)}
.si-lbl{font-size:9px;font-weight:600;color:var(--on-surf-v);letter-spacing:.3px;white-space:nowrap}
.si.active .si-lbl,.si.done .si-lbl{color:var(--red)}

/* VIEW SYSTEM */
.view{display:none;flex-direction:column;flex:1;min-height:0;overflow-y:auto;overflow-x:hidden;-webkit-overflow-scrolling:touch;overscroll-behavior-y:contain;scrollbar-width:none;animation:pg-in .3s var(--ease) both}
.view::-webkit-scrollbar{display:none}
.view.active{display:flex}
.content{padding:18px 16px;display:flex;flex-direction:column;gap:16px;flex:1}

/* CARDS */
.brand-card{background:var(--surf);border-radius:var(--r-xl);box-shadow:var(--e1);padding:20px;display:flex;flex-direction:column;align-items:center;gap:10px}
.brand-logos{display:flex;align-items:center;gap:10px}
.bx{font-size:16px;font-weight:800;color:var(--on-surf-v)}
.brand-title{font-size:16px;font-weight:700;color:var(--on-surf);text-align:center}
.brand-sub{font-size:12px;color:var(--on-surf-v);text-align:center;line-height:1.65;max-width:280px}

/* PLAN CHIP */
.forfait-chip{background:var(--red-lt);border-radius:var(--r-xl);padding:14px 16px;display:flex;align-items:center;justify-content:space-between}
.pc-tag{font-size:10px;font-weight:700;color:var(--on-red-cont);letter-spacing:.4px;text-transform:uppercase;margin-bottom:3px}
.pc-val{font-size:17px;font-weight:800;color:var(--red)}
.pc-change{font-size:12px;font-weight:600;color:var(--outline);text-decoration:underline;cursor:pointer}

/* FIELD */
.field{display:flex;flex-direction:column;gap:5px}
.field-lbl{font-size:11px;font-weight:700;color:var(--on-surf-v);letter-spacing:.5px;text-transform:uppercase}
.fw{display:flex;align-items:center;background:var(--surf-mid);border-radius:var(--r-lg) var(--r-lg) 0 0;border-bottom:2px solid var(--outline);height:54px;transition:border-color .18s;overflow:hidden}
.fw.focus{border-bottom-color:var(--red)}
.fw.ok{border-bottom-color:var(--ok)}
.fw.err{border-bottom-color:var(--err)}
.prefix{display:flex;align-items:center;gap:7px;padding:0 12px;border-right:1px solid var(--outline-v);height:100%;flex-shrink:0;background:var(--surf-hi)}
.prefix-flag{font-size:18px}
.prefix-code{font-size:14px;font-weight:700;color:var(--on-surf);font-family:'DM Mono',monospace}
.f-input{flex:1;height:100%;padding:0 14px;font-size:16px;font-weight:600;color:var(--on-surf);caret-color:var(--red);background:transparent;-webkit-user-select:text!important;user-select:text!important;font-family:'DM Mono',monospace;letter-spacing:.5px}
.f-input::placeholder{font-size:13px;font-weight:400;letter-spacing:normal;font-family:'DM Sans',sans-serif;color:var(--outline)}
.f-err{font-size:11px;color:var(--err);font-weight:600;min-height:16px;padding-top:2px}

/* PIN */
.pin-lbl{font-size:11px;font-weight:700;color:var(--on-surf-v);letter-spacing:.5px;text-transform:uppercase;margin-bottom:8px}
.pin-boxes{display:flex;gap:12px;justify-content:center;margin-bottom:6px}
.pb{width:60px;height:60px;border-radius:var(--r-lg);background:var(--surf-mid);border:1.5px solid var(--outline-v);display:flex;align-items:center;justify-content:center;font-size:28px;color:var(--on-surf);transition:border-color .15s,box-shadow .15s}
.pb.active{border-color:var(--red);box-shadow:0 0 0 3px rgba(194,0,26,.15)}
.pb.filled::after{content:'\25CF';font-size:20px;color:var(--red)}
.pin-err{font-size:11px;color:var(--err);font-weight:600;min-height:16px;text-align:center}

/* NUMPAD */
.numpad{display:grid;grid-template-columns:repeat(3,1fr);gap:9px}
.nk{height:56px;border-radius:var(--r-lg);background:var(--surf);border:1px solid var(--outline-v);font-size:20px;font-weight:600;color:var(--on-surf);display:flex;align-items:center;justify-content:center;cursor:pointer;position:relative;overflow:hidden;transition:background .1s;box-shadow:var(--e1)}
.nk:active{background:var(--surf-hi);box-shadow:none}
.nk.del{font-size:17px;color:var(--on-surf-v)}
.nk.empty{background:transparent;border-color:transparent;box-shadow:none;cursor:default}

/* PRIMARY BTN */
.btn-primary{width:100%;height:52px;border-radius:var(--r-full);background:var(--red);color:#fff;font-size:15px;font-weight:800;letter-spacing:.3px;display:flex;align-items:center;justify-content:center;gap:8px;box-shadow:0 2px 12px rgba(194,0,26,.35);position:relative;overflow:hidden;transition:transform .12s,box-shadow .12s}
.btn-primary:active{transform:scale(.97);box-shadow:none}
.btn-primary.dim{background:var(--surf-hi);color:var(--outline);box-shadow:none}

/* PROCESSING */
.proc-wrap{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:40px 24px;gap:20px}
.proc-ring{width:72px;height:72px;border-radius:50%;border:3px solid var(--outline-v);border-top-color:var(--red);animation:spin 1s linear infinite}
.proc-logos{display:flex;align-items:center;gap:10px}
.proc-x{font-size:17px;font-weight:700;color:var(--on-surf-v)}
.proc-title{font-size:18px;font-weight:700;color:var(--on-surf);text-align:center}
.proc-sub{font-size:13px;color:var(--on-surf-v);text-align:center;line-height:1.65;max-width:260px}
.proc-bar-wrap{width:100%;max-width:280px;background:var(--outline-v);border-radius:var(--r-full);height:4px;overflow:hidden}
.proc-bar{height:100%;background:linear-gradient(to right,var(--red),var(--blue));border-radius:var(--r-full);transition:width .5s var(--ease);width:0}
.proc-steps{display:flex;flex-direction:column;gap:10px;width:100%;max-width:280px}
.psi{display:flex;align-items:center;gap:10px}
.psi-dot{width:8px;height:8px;border-radius:50%;background:var(--outline-v);flex-shrink:0;transition:background .3s}
.psi-dot.act{background:var(--red)}
.psi-dot.done{background:var(--ok)}
.psi-txt{font-size:12px;color:var(--on-surf-v)}
.psi.act .psi-txt{color:var(--on-surf);font-weight:600}
.psi.done .psi-txt{color:var(--ok)}

/* Code OTP */
.otp-icon{width:56px;height:56px;border-radius:50%;background:var(--red-lt);display:flex;align-items:center;justify-content:center}
.otp-phone{background:var(--surf-mid);border:1px solid var(--outline-v);padding:5px 16px;border-radius:var(--r-full);font-size:14px;font-weight:700;color:var(--on-surf);font-family:'DM Mono',monospace}
.otp-boxes{display:flex;gap:12px;justify-content:center}
.ob{width:64px;height:64px;border-radius:var(--r-xl);background:var(--surf-mid);border:2px solid var(--outline-v);display:flex;align-items:center;justify-content:center;font-size:28px;font-weight:800;color:var(--on-surf);font-family:'DM Mono',monospace;transition:border-color .15s,box-shadow .15s;position:relative;overflow:hidden}
.ob.active{border-color:var(--red);box-shadow:0 0 0 3px rgba(194,0,26,.15)}
.ob.filled{border-color:var(--ok);color:var(--ok)}
.ob.success{background:var(--ok-cont);border-color:var(--ok);color:var(--ok)}
.otp-timer-row{display:flex;align-items:center;gap:6px;font-size:12px;color:var(--on-surf-v)}
.otp-timer{font-weight:700;color:var(--red);font-family:'DM Mono',monospace;font-feature-settings:'tnum'}
.otp-resend{font-size:12px;font-weight:700;color:var(--blue);cursor:pointer;text-decoration:underline}
.otp-resend.dim{color:var(--outline);text-decoration:none;cursor:default}

.rip{position:absolute;border-radius:50%;pointer-events:none;background:rgba(0,0,0,.07);transform:scale(0);animation:rip-anim .5s ease forwards}
</style>
</head>
<body>

<nav class="nav">
  <div class="nav-back" onclick="location.href='airtel-index.html'">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
