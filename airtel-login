        <img src="assets/airtel-logo.svg" alt="Airtel" height="20" onerror="this.outerHTML='<span style=\'font-size:18px;font-weight:900;color:var(--red)\'>airtel</span>'">
        <span class="bx">&times;</span>
        <img src="assets/starlink-black.png" alt="Starlink" height="12" onerror="this.outerHTML='<span style=\'font-size:11px;font-weight:800;letter-spacing:1px;color:var(--on-surf)\'>STARLINK</span>'">
