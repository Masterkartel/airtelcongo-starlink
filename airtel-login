    <div class="proc-steps">
      <div class="psi act" id="psi0"><div class="psi-dot act"></div><div class="psi-txt">Connexion s&eacute;curis&eacute;e &eacute;tablie</div></div>
      <div class="psi" id="psi1"><div class="psi-dot"></div><div class="psi-txt">V&eacute;rification du compte Airtel</div></div>
